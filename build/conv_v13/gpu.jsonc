{
  "$schema": "https://gpu-cli.sh/schema/v1/gpu.json",
  // own-names-bench v1.3 conversation test suite: built on the EUR-IS-1 global volume (gpu-cli-user), where the
  // conversation train/dev copy v0.6 trains on is (read only); the suite has its own path, onb-v13-conv-SEALED
  "project_id": "onb-v13-convsuite",
  "workspace_namespace": "jameslal",
  "workspace_namespace_source": "user_env",
  "provider": "runpod",
  "regions": ["EUR-IS-1"],
  "include": ["_onb/"],
  "exclude": ["out/", ".venv/", "__pycache__/", "*.log"],
  "outputs": ["out/"],
  "outputs_enabled": true,
  "encryption": false,
  "cloud_type": "secure",
  "min_vram": 16,
  "gpu_types": [
    { "type": "NVIDIA GeForce RTX 4090", "count": 1 },
    { "type": "NVIDIA RTX A6000", "count": 1 },
    { "type": "NVIDIA A40", "count": 1 },
    { "type": "NVIDIA L40S", "count": 1 },
    { "type": "NVIDIA GeForce RTX 5090", "count": 1 },
    { "type": "NVIDIA RTX PRO 4500 Blackwell", "count": 1 },
    { "type": "NVIDIA A100-SXM4-80GB", "count": 1 },
    { "type": "NVIDIA RTX PRO 6000 Blackwell Server Edition", "count": 1 }
  ],
  "keep_alive_minutes": 10,
  "max_idle_spend": 0.5
}
